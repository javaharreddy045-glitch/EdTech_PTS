PORT=5000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:student@localhost:5432/edtech

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# Password reset token expiry (minutes)
RESET_TOKEN_EXPIRES_MINUTES=30

# Used to build the reset link sent in the password reset email
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) - used to send password reset emails.
# Leave RESEND_API_KEY unset in local dev to fall back to the token being
# logged server-side and returned in the API response instead of emailed.
RESEND_API_KEY=
MAIL_FROM=PathToSkill <onboarding@resend.dev>
